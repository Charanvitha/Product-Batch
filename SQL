-- questions

1)select d.dept_name,count(e.emp_id) as employee_count,avg(e.salary) as average_salary,min(e.salary) as min_salary,max(e.salary) as max_salary 
from Employees e 
left join Departments d on e.dept_id=d.dept_id group by d.dept_id,d.dept_name;


2)select dept_id,emp_id,emp_name,salary
from (
    select
        e.*,
        dense_rank() over (
            partition by dept_id
            order by salary desc
        ) as salary_rank
    from Employees e
) x
where salary_rank = 2;


3)select dept_id,emp_name,salary 
from Employees e
where salary>(select avg(d.salary) from Employees d where d.dept_id=e.dept_id);



4)select
  m.emp_id as manager_id,
  m.emp_name as manager_name,
  m.salary as manager_salary,
  count(e.emp_id) as direct_report_count,
  sum(e.salary) as team_salary
from Employees m
join Employees e on e.manager_id=m.emp_id
group by 
   m.emp_id,
   m.emp_name,
   m.salary
having direct_report_count>=2;



5)select 
    project_id,
    project_name,
    emp_id,
    emp_name,
    total_hours
from (
    select
        p.project_id,
        p.project_name,
        e.emp_id,
        e.emp_name,
        SUM(ep.hours_worked) AS total_hours,
        dense_rank() over(
            partition by p.project_id
            order by SUM(ep.hours_worked) desc
        ) as rnk
    from Projects p
    join EmployeeProjects ep
        on p.project_id = ep.project_id
    join Employees e
        on e.emp_id = ep.emp_id
    group by
        p.project_id,
        p.project_name,
        e.emp_id,
        e.emp_name
) x
where rnk <= 2;



6)select
   d.dept_id,
   d.dept_name
from Departments d
where exists(
  select 1 from Employees e where e.dept_id=d.dept_id
)
and not exists(
  select 1 from Projects p where p.dept_id=d.dept_id
);



8)select 
  customer_id,
  sum(amount) as completed_order_value,
  case
     when sum(amount)>=100000 then 'platinum'
     when sum(amount)>=50000 then 'gold'
     when sum(amount)>=20000 then 'silver'
     else 'bronze'
  end as customer_classification
from Orders
where status='COMPLETED'
group by customer_id;
